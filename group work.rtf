\b Question 20\b0 : Dart Data Types and Naming Conventions\par
Question: Write a Dart program demonstrating different data types, dynamic, Object, nullable variables, type inference, a StudentProfile class and a calculateTotal() function.\par
\par
Answer:\par
// Creating a class\par
class StudentProfile \{\par
  String studentName = "Chrisostome";\par
  int studentAge = 20;\par
\}\par
void main() \{\par
  // 1. Different data types\par
  int age = 20;\par
  double marks = 85.5;\par
  String studentName = "Chrisostome";\par
  bool isStudent = true;\par
  // 2. Dynamic variable\par
  dynamic value = 100;\par
  print(value);\par
  value = "Hello Dart";\par
  print(value);\par
  value = true;\par
  print(value);\par
  // 3. Object variable\par
  Object studentInfo = "Chrisostome";\par
  print(studentInfo);\par
  studentInfo = 12;\par
  print(studentInfo);\par
  studentInfo = true;\par
  print(studentInfo);\par
  // 4. Nullable String\par
  String? schoolName = "CMS UNILAK";\par
  print(schoolName);\par
  // 5. Type inference using var\par
  var department = "Software Development";\par
  print(department);\par
  // 6. Creating StudentProfile object\par
  StudentProfile student = StudentProfile();\par
  print(student.studentName);\par
  print(student.studentAge);\par
  // 7. Calling calculateTotal()\par
  int total = calculateTotal(80, 85, 90);\par
  print("Total marks: $total");\par
\}\par
// Function to calculate total marks\par
int calculateTotal(int mark1, int mark2, int mark3) \{\par
  return mark1 + mark2 + mark3;\par
\}\par
Expected output:\par
100\par
Hello Dart\par
true\par
Chrisostome\par
12\par
true\par
CMS UNILAK\par
Software Development\par
Chrisostome\par
20\par
Total marks: 255\par

